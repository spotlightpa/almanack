{
  "name": "almanack",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "yarn run test:eslint && yarn run test:prettier && yarn run test:types",
    "test:eslint": "eslint src",
    "test:types": "vue-tsc --noEmit",
    "test:prettier": "prettier --ignore-path .gitignore --check './*.{js,ts,vue,yml,json}' 'src/**/*.{js,ts,vue,yml,json}'",
    "lint": "yarn run lint:eslint && yarn run lint:prettier",
    "lint:eslint": "eslint --fix src",
    "lint:prettier": "prettier --ignore-path .gitignore --write './*.{js,ts,vue,yml,json}' 'src/**/*.{js,ts,vue,yml,json}'"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@sentry/vue": "^10.70.0",
    "@unhead/vue": "^3.3.1",
    "bulma": "^0.9.4",
    "journalize": "^2.5.1",
    "netlify-identity-widget": "^1.9.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "^8.2.1",
    "vite-plugin-eslint": "^1.7.0",
    "vue-eslint-parser": "^10.1.1",
    "vue-tsc": "^3.3.9"
  },
  "prettier": {
    "trailingComma": "es5"
  },
  "private": true
}
